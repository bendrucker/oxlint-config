{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    // The pedantic category in base.json turns on the type-aware rules
    // (no-unsafe-*, strict-void-return, switch-exhaustiveness-check, ...),
    // which run under `oxlint --type-aware`. These are the style, restriction,
    // and nursery rules on top.

    // typescript/require-await understands returned thenables and replaces it.
    "require-await": "off",
    // A `default` branch silences switch-exhaustiveness-check, which reports
    // the missing member of a union instead.
    "default-case": "off",
    // Reads a type alias and a value of the same name, the zod
    // `const X = z.object(); type X = z.infer<typeof X>` pattern, as a
    // redeclaration. The compiler reports real ones.
    "no-redeclare": "off",
    // strictNullChecks reports the same call or access on a possibly
    // undefined value.
    "no-unsafe-optional-chaining": "off",

    "typescript/array-type": "error",
    "typescript/consistent-generic-constructors": "error",
    // An index signature admits any key of the right type, so a typo'd
    // property name is accepted instead of rejected as an unknown key.
    "typescript/consistent-indexed-object-style": "error",
    // Mixing assertion styles hides which casts were actually reviewed
    // versus which ones were bolted on to silence the compiler.
    "typescript/consistent-type-assertions": "error",
    "typescript/consistent-type-definitions": "error",
    // Bracket access defeats the property-rename and typo safety that dot
    // notation gets from the compiler.
    "typescript/dot-notation": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-explicit-any": "error",
    // An explicit annotation that drifts from the initializer's real type
    // is still accepted, so the mismatch goes unnoticed.
    "typescript/no-inferrable-types": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-condition": ["error", { "allowConstantLoopConditions": "always" }],
    // An `as` cast to a non-nullable type can drift from the operand's real
    // type across a refactor without the compiler re-checking it, the way
    // the `!` operator does.
    "typescript/non-nullable-type-assertion-style": "error",
    // `.filter()[0]` builds and discards the rest of the filtered array to
    // read a single element back out of it.
    "typescript/prefer-find": "error",
    // A hand-indexed `for` loop over a whole array carries an index
    // variable that a `for...of` loop wouldn't need to introduce at all.
    "typescript/prefer-for-of": "error",
    // A chain of `&&` guards re-tests each link and breaks silently if one is dropped or reordered.
    "typescript/prefer-optional-chain": "error",
    // A private field assigned only in the constructor but left mutable
    // lets later code reassign it without the compiler objecting.
    "typescript/prefer-readonly": "error",
    // A `slice`/`substring` comparison allocates a throwaway string just to test a prefix or suffix.
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowString": false,
        "allowNumber": false,
        "allowNullableString": false,
        "allowNullableNumber": false,
        "allowNullableObject": true,
        "allowNullableBoolean": true
      }
    ],
    // A catch callback's error parameter typed as anything but unknown lets
    // its properties be read without confirming the rejection has that shape.
    "typescript/use-unknown-in-catch-callback-variable": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx,mts,cts}"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}

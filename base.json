{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "promise", "node", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    // Pedantic rules turned back off. Each is a convention, a per-codebase
    // threshold, or a rule that fires on a correct idiom.
    "max-lines": "off",
    "max-lines-per-function": "off",
    "import/max-dependencies": "off",
    // A guard clause reads naturally negated, and flipping it to satisfy the
    // rule nests the main path.
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "no-inline-comments": "off",
    "require-unicode-regexp": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    // Conflicts with prefer-native-coercion-functions, which asks for
    // `.filter(Boolean)` and `.map(String)`.
    "unicorn/no-array-callback-reference": "off",
    // Conflicts with an explicit `return undefined` from a function typed to
    // return `T | undefined`.
    "unicorn/no-useless-undefined": "off",
    "unicorn/escape-case": "off",
    "unicorn/no-hex-escape": "off",
    // Matches any `.catch(...)` call at the top level, including zod's
    // `.catch(fallback)` schema method.
    "unicorn/prefer-top-level-await": "off",
    // Its autofix changes results: `Number("")` is 0 where `parseFloat("")`
    // is NaN, and `Number("12px")` is NaN where `parseInt` reads 12.
    "unicorn/prefer-number-coercion": "off",
    // Targets closures over a shared `var`. With block-scoped bindings the
    // remaining hits are deliberate closures over loop state.
    "no-loop-func": "off",
    // Fires on any check before a throw, including value checks like
    // `Number.isNaN` where TypeError is the wrong class.
    "unicorn/prefer-type-error": "off",
    // Conflicts with oxc/no-map-spread when the array is built inside a map
    // callback.
    "unicorn/no-immediate-mutation": "off",
    // One push per emitted line keeps output-building code diffable.
    "unicorn/prefer-single-call": "off",
    // A table-driven test branches on the case it is running.
    "vitest/no-conditional-in-test": "off",

    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-unused-expressions": ["error", { "allowTernary": true }],
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-underscore-dangle": ["error", { "allow": ["__typename", "__dirname", "__filename"] }],

    // Style, restriction, and nursery rules, opted into one at a time.
    // A switch missing a default leaves a new case value unhandled, falling through silently.
    "default-case": "error",
    "no-duplicate-imports": "error",
    "no-empty": "error",
    // An empty function body stands in for logic that was never written,
    // so a caller invoking it gets silence instead of an error.
    "no-empty-function": "error",
    // A shorthand coercion like `!!x` or `""+x` hides the intended
    // conversion behind an operator that reads as something else.
    "no-implicit-coercion": "error",
    // A ternary nested inside another packs two decisions into one expression,
    // forcing the reader to unravel both to see what it actually returns.
    "no-nested-ternary": "error",
    // Reassigning a parameter overwrites the caller's argument binding, so a
    // later read of it no longer reflects what was passed in.
    "no-param-reassign": "error",
    "no-template-curly-in-string": "warn",
    // An assignment overwritten before it's ever read wastes the write.
    "no-useless-assignment": "error",
    // Repeating the key and value name is an easy source of a copy-paste
    // mismatch between the two.
    "object-shorthand": "error",
    // A `let` nobody reassigns means a future accidental reassignment goes
    // uncaught.
    "prefer-const": "error",
    "prefer-object-spread": "error",
    "prefer-template": "error",
    // A circular import loads with a partially-initialized binding, and
    // which side resolves first depends on import order.
    "import/no-cycle": "error",
    "import/no-namespace": "error",
    "promise/avoid-new": "error",
    // A promise chain with no catch and no return lets a rejection disappear
    // instead of propagating to a caller or being handled.
    "promise/catch-or-return": "error",
    // A value returned from `finally` silently overrides whatever the
    // try/catch block already returned or threw.
    "promise/no-return-in-finally": "error",
    "unicorn/catch-error-name": "error",
    // Mixing `> -1` and `!== -1` for the same existence check reads as two different tests of one fact.
    "unicorn/consistent-existence-index-check": "error",
    "unicorn/custom-error-definition": "error",
    // A thrown error with no message surfaces as an empty string with no
    // clue what happened.
    "unicorn/error-message": "error",
    // A blanket eslint-disable silences every rule at once, hiding future
    // violations the disable was never meant to cover.
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-array-for-each": "error",
    // A `.reduce()` accumulator's shape lives inside the callback, so a
    // reader has to simulate the whole loop to see what's being built.
    "unicorn/no-array-reduce": "error",
    // Positional holes in a destructure leave it unclear which index each
    // name binds to as the array shifts.
    "unicorn/no-unreadable-array-destructuring": "error",
    // Reassigning a parameter to fill in a missing value hides the
    // fallback in the function body instead of the signature.
    "unicorn/prefer-default-parameters": "error",
    "unicorn/prefer-export-from": "error",
    // `.indexOf() !== -1` leaks a numeric index nobody uses, and `> -1`
    // misclassifies an `.indexOf()` result of 0.
    "unicorn/prefer-includes": "error",
    // Repeating the condition on both sides of a ternary lets one branch's
    // condition drift from the other when only one is edited.
    "unicorn/prefer-logical-operator-over-ternary": "error",
    // A bare specifier like `fs` can resolve to a same-named npm package
    // instead of the builtin.
    "unicorn/prefer-node-protocol": "error",
    // A hand-rolled reduce-to-object mutates a fresh object every
    // iteration instead of building the result once.
    "unicorn/prefer-object-from-entries": "error",
    // An unused `catch (error)` binding discards a caught bug's detail
    // even from logs.
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-string-raw": "error",
    // An if/else that only assigns or returns duplicates the branch target for what is one expression.
    "unicorn/prefer-ternary": "error",
    // The vitest plugin matches the Jest-style API shape, not the import, so it
    // covers bun:test and node:test suites too. These two read source prose and
    // ordinary loops as tests, so they run only over test files.
    "vitest/no-commented-out-tests": "off",
    "vitest/prefer-each": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "vitest/no-commented-out-tests": "error",
        "vitest/prefer-each": "error"
      }
    }
  ]
}
